# Salin file ini jadi ".env" lalu sesuaikan

PORT=3000
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# Radius default geofence (meter) kalau area belum diset per-titik
DEFAULT_GEOFENCE_RADIUS_M=300

# Folder penyimpanan foto selfie
UPLOAD_DIR=./uploads

# --- Estimasi lokasi cell tower (opsional tapi direkomendasikan) ---
# Daftar API key gratis di https://opencellid.org/register
# Kalau dikosongkan, fitur cross-check GPS vs tower otomatis dilewati (tidak error).
OPENCELLID_API_KEY=

# Ambang batas (meter) selisih GPS vs estimasi tower sebelum ditandai "perlu_review".
# Dibuat longgar karena estimasi tower di area rural/kebun bisa meleset jauh.
CELL_TOWER_ANOMALI_THRESHOLD_M=15000
