<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= LAYAR: ABSENSI ================= -->
        <ScrollView
            android:id="@+id/layarAbsensi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header ink -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/ink"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="30dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="30dp" android:layout_height="30dp"
                            android:background="@drawable/bg_circle_ink" android:backgroundTint="@color/paper"
                            android:layout_marginEnd="9dp" />

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvEyebrowAbsensi"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:fontFamily="monospace" android:letterSpacing="0.12" android:textAllCaps="true"
                                android:textSize="10sp" android:textColor="@color/gray_soft" />
                            <TextView
                                android:id="@+id/tvNamaPekerja"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black" android:textAllCaps="true"
                                android:textSize="24sp" android:textColor="@color/paper" android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginTop="14dp">

                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvJamSekarang"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:fontFamily="monospace" android:textStyle="bold" android:textSize="19sp" android:textColor="@color/paper" />
                            <TextView
                                android:id="@+id/tvTanggalSekarang"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:fontFamily="monospace" android:textSize="9.5sp" android:textColor="@color/gray_soft" android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStatusPill"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Belum absen" android:fontFamily="monospace" android:textSize="10.5sp"
                            android:textColor="@color/paper" android:paddingHorizontal="11dp" android:paddingVertical="5dp"
                            android:background="@drawable/bg_status_pill_outline" android:textAllCaps="true" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">

                    <!-- Tombol stamp bulat -->
                    <LinearLayout
                        android:id="@+id/zonaStamp"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:paddingTop="14dp">

                        <Button
                            android:id="@+id/btnAbsenMasuk"
                            android:layout_width="170dp" android:layout_height="170dp"
                            android:background="@drawable/bg_circle_stamp"
                            android:backgroundTint="@null"
                            android:stateListAnimator="@null"
                            android:text="ABSEN\nMASUK"
                            android:fontFamily="sans-serif-black"
                            android:textAllCaps="true"
                            android:textSize="15sp"
                            android:lineSpacingMultiplier="1.05"
                            android:textColor="@color/ink" />

                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tekan untuk mencatat kehadiran.\nLokasi &amp; tower terdeteksi otomatis."
                            android:textSize="12sp" android:textColor="@color/gray" android:gravity="center"
                            android:layout_marginTop="14dp" android:maxWidth="230dp" />

                        <Button
                            android:id="@+id/btnAbsenKeluar"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ABSEN KELUAR"
                            android:fontFamily="monospace" android:textSize="11sp" android:letterSpacing="0.06"
                            android:textColor="@color/ink" android:background="@drawable/bg_btn_outline_ink"
                            android:backgroundTint="@null"
                            android:stateListAnimator="@null"
                            android:paddingHorizontal="18dp"
                            android:layout_marginTop="18dp" />

                        <ProgressBar
                            android:id="@+id/progressAbsen"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvAntrianOffline"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="10.5sp" android:textColor="@color/amber" android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="RIWAYAT TERAKHIR"
                        android:fontFamily="monospace" android:letterSpacing="0.1" android:textAllCaps="true"
                        android:textSize="10sp" android:textColor="@color/gray"
                        android:layout_marginTop="26dp" android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/listRiwayat"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ================= LAYAR: TOWER ================= -->
        <ScrollView
            android:id="@+id/layarTower"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:fillViewport="true">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <include layout="@layout/partial_header_ink" android:id="@+id/hdrTower" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:background="@drawable/bg_card_bordered"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/tvTowerId"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black" android:textAllCaps="true"
                            android:textSize="24sp" android:textColor="@color/ink" />

                        <TextView
                            android:id="@+id/tvTowerSub"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:fontFamily="monospace" android:textSize="10.5sp" android:textColor="@color/gray"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <GridLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:columnCount="2" android:layout_marginTop="14dp">

                        <LinearLayout style="@style/DetailItemBox" android:layout_columnWeight="1" android:layout_marginEnd="5dp" android:layout_marginBottom="10dp">
                            <TextView style="@style/DetailItemLabel" android:text="MCC / MNC" />
                            <TextView android:id="@+id/tvMccMnc" style="@style/DetailItemValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/DetailItemBox" android:layout_columnWeight="1" android:layout_marginStart="5dp" android:layout_marginBottom="10dp">
                            <TextView style="@style/DetailItemLabel" android:text="LAC" />
                            <TextView android:id="@+id/tvLac" style="@style/DetailItemValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/DetailItemBox" android:layout_columnWeight="1" android:layout_marginEnd="5dp">
                            <TextView style="@style/DetailItemLabel" android:text="Cell ID" />
                            <TextView android:id="@+id/tvCellId" style="@style/DetailItemValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/DetailItemBox" android:layout_columnWeight="1" android:layout_marginStart="5dp">
                            <TextView style="@style/DetailItemLabel" android:text="Est. Radius" />
                            <TextView android:id="@+id/tvEstRadius" style="@style/DetailItemValue" />
                        </LinearLayout>
                    </GridLayout>

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:background="@drawable/bg_note_left_border"
                        android:layout_marginTop="18dp">
                        <TextView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Info tower dipakai sebagai data pendukung untuk verifikasi lokasi (estimasi via OpenCellID), bukan penentu utama status absen kamu."
                            android:textSize="11sp" android:textColor="@color/gray" android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ================= LAYAR: PROFIL ================= -->
        <ScrollView
            android:id="@+id/layarProfil"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:fillViewport="true">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <include layout="@layout/partial_header_ink" android:id="@+id/hdrProfil" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:paddingTop="6dp">

                        <TextView
                            android:id="@+id/tvAvatarInisial"
                            android:layout_width="76dp" android:layout_height="76dp"
                            android:background="@drawable/bg_circle_ink"
                            android:gravity="center" android:fontFamily="sans-serif-black"
                            android:textSize="26sp" android:textColor="@color/paper" />

                        <TextView
                            android:id="@+id/tvProfilNama"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black" android:textAllCaps="true" android:textSize="22sp"
                            android:textColor="@color/ink" android:layout_marginTop="10dp" />

                        <TextView
                            android:id="@+id/tvProfilId"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:fontFamily="monospace" android:textSize="11sp" android:textColor="@color/gray" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginTop="18dp">

                        <LinearLayout style="@style/ProfileRow">
                            <TextView style="@style/ProfileRowKey" android:text="Status Sesi" />
                            <TextView android:text="Aktif" style="@style/ProfileRowValue" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:background="@drawable/bg_card_bordered"
                        android:padding="13dp" android:layout_marginTop="14dp">
                        <TextView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Persetujuan Data Lokasi: Aktif — lokasi &amp; info tower hanya diambil saat kamu menekan tombol absen atau membuka app."
                            android:textSize="10.5sp" android:textColor="@color/gray" android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnLogout"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:text="KELUAR AKUN" android:fontFamily="monospace" android:letterSpacing="0.06"
                        android:textSize="12sp" android:textColor="@color/ink"
                        android:background="@drawable/bg_btn_outline_ink" android:backgroundTint="@null" android:stateListAnimator="@null"
                        android:layout_marginTop="22dp" />

                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- ================= BOTTOM NAV ================= -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/white"
        android:paddingTop="10dp" android:paddingBottom="14dp"
        android:elevation="4dp">

        <LinearLayout
            android:id="@+id/navAbsensi"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <TextView android:id="@+id/glyphNavAbsensi" android:text="✓" android:textSize="14sp" android:fontFamily="sans-serif-black" android:textColor="@color/ink" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:text="ABSENSI" android:textSize="9.5sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTower"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <TextView android:id="@+id/glyphNavTower" android:text="▲" android:textSize="14sp" android:fontFamily="sans-serif-black" android:textColor="@color/gray_soft" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtNavTower" android:text="TOWER" android:textSize="9.5sp" android:textStyle="bold" android:textColor="@color/gray_soft" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfil"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <TextView android:id="@+id/glyphNavProfil" android:text="●" android:textSize="14sp" android:fontFamily="sans-serif-black" android:textColor="@color/gray_soft" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtNavProfil" android:text="PROFIL" android:textSize="9.5sp" android:textStyle="bold" android:textColor="@color/gray_soft" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
