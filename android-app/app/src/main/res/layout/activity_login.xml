<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== HERO GELAP ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/ink"
            android:paddingHorizontal="22dp"
            android:paddingTop="40dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_circle_ink"
                    android:backgroundTint="@color/paper"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABSEN KEBUN"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.14"
                    android:textSize="11sp"
                    android:textColor="@color/gray_soft" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MASUK\nAKUN"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="true"
                android:textSize="38sp"
                android:lineSpacingMultiplier="0.9"
                android:textColor="@color/paper" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Catat kehadiran panen kamu tiap hari, langsung dari lokasi kebun."
                android:textSize="12.5sp"
                android:textColor="@color/gray_soft"
                android:layout_marginTop="12dp"
                android:maxWidth="240dp" />
        </LinearLayout>

        <!-- ===== FORM ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID PEKERJA"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textSize="9.5sp"
                android:textColor="@color/gray"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etKode"
                android:textColor="@color/ink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="KB-0142"
                android:inputType="textCapCharacters"
                android:textSize="13sp"
                android:textColorHint="@color/gray_soft"
                android:background="@drawable/bg_field_input"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PIN"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textSize="9.5sp"
                android:textColor="@color/gray"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etPin"
                android:textColor="@color/ink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="••••••••"
                android:inputType="numberPassword"
                android:textSize="13sp"
                android:textColorHint="@color/gray_soft"
                android:background="@drawable/bg_field_input"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="MASUK →"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/paper"
                android:background="@drawable/bg_btn_solid_ink"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/tvErrorLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/clay"
                android:textSize="12sp"
                android:layout_marginTop="10dp" />

            <ProgressBar
                android:id="@+id/progressLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/paper_dim"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dashed_box"
                android:padding="13dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Belum punya akun? Hubungi mandor blok kamu untuk didaftarkan sebagai pekerja kebun."
                    android:textSize="11sp"
                    android:textColor="@color/gray"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
